# ---------------------------------------------------------------------------
# Sprintal environment variables. Copy to `.env.local` and fill in real values.
# NEXT_PUBLIC_* are exposed to the browser; everything else is server-only.
# NEVER commit real secrets. service_role and API keys must stay server-side.
# ---------------------------------------------------------------------------

# --- Supabase ---
# Project URL and public anon key are safe for the browser (RLS-bound).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role bypasses RLS — server-only, used ONLY in /app/api routes (rule #1).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic / AI coaches ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model IDs are read from env, never hardcoded (rule #4).
# Syntactic/formulation coach (fast, e.g. Haiku):
AI_MODEL_FORMULATION=claude-haiku-4-5-20251001
# Semantic coach (deep reasoning + web_search, e.g. Sonnet 4.5):
AI_MODEL_SEMANTIC=claude-sonnet-4-5
# Fallback model for graceful degradation:
AI_MODEL_FALLBACK=claude-haiku-4-5-20251001

# --- Paddle Billing (Merchant of Record) ---
# Client-side token for Paddle.js checkout:
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-token
# Sandbox or production:
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Server-side API key and webhook signing secret:
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# --- Resend (transactional email) ---
RESEND_API_KEY=your-resend-api-key

# --- App ---
# Public base URL of the deployment (used by Playwright, redirects, emails):
NEXT_PUBLIC_APP_URL=http://localhost:3000
